{
  "name": "hoa-don-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:safety": "node --test scripts/test-sync-safety.mjs scripts/test-invoice-trash.mjs scripts/test-server-safety.mjs scripts/test-invoice-packages.mjs",
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:staging": "node node_modules/vite/bin/vite.js --mode staging",
    "build:staging": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build --mode staging",
    "preview:staging": "node node_modules/vite/bin/vite.js preview --mode staging",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite-plugin-pwa": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
